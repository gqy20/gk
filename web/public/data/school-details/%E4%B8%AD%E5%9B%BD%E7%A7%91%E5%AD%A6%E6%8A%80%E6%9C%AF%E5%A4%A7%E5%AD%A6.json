    "student_experiences": [
      {
        "topic": "中科大转专业难度",
        "content": "中科大转专业相对自由，大一期末可申请全校转专业。绝大部分院系成绩要求GPA≥3.0（约各院前70%），少部分院系要求较高如数院GPA≥3.6。转专业需参加笔试面试，数院有笔试（数学分析和线性代数）。总体来说科大转专业成功率较高。",
        "source_type": "知乎",
        "source_url": "https://www.zhihu.com/question/539162518"
      },
      {
        "topic": "中科大转专业成功率",
        "content": "从个性化这条路看，在科大几乎可以选喜欢的任何专业。转专业成功率直逼100%。或许是妮可大一大二都在过分注重数理基础，为跨专业打下了基础。",
        "source_type": "知乎",
        "source_url": "https://www.zhihu.com/question/539162518"
      },
      {
        "topic": "中科大专业分流规则",
        "content": "核学院、管理学院大一下学期期末分流；网络空间安全学院、计算机学院等只有单一专业自动分流；其他学院大二下学期期末分流。少年班学院大一下学期期末安排选专业。",
        "source_type": "非官方学生指南",
        "source_url": "https://erictianc.github.io/USTCGUIDE_mkdocs/学习/zhuan-zhuan-ye-fen-liu-ge-xing-hua/"
      },
      {
        "topic": "中科大选课建议",
        "content": "选课前可参考学长学姐经验，关注课程难度和给分情况。教务系统开放时及时选课热门课程竞争激烈。学业指导中心提供专业选择指导服务。",
        "source_type": "知乎",
        "source_url": "https://www.zhihu.com/question/416074507"
      },
      {
        "topic": "B站中科大转专业经验",
        "content": "视频分享了转专业难度排行分析，建议关注目标学院的转入名额和竞争情况。提前了解目标专业的课程要求，做好学业规划。",
        "source_type": "B站",
        "source_url": "https://www.bilibili.com/video/BV1Rr421b7Ww/"
      }
    ],
