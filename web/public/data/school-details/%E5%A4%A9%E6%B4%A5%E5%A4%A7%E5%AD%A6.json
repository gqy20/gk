    "transfer_policy": [
      {
        "title": "天津大学本科生主修专业确认、转专业及个性化培养实施办法",
        "url": "https://so.html5.qq.com/page/real/search_news?docid=70000021_19369c1e2f084952",
        "summary": "2026年3月9日起施行。核心亮点：(1)主修专业确认按大类内“遵循志愿”原则分批次进行，学生可在大类内任选专业；(2)转出不限制，申请转出不受绩点、排名、名额限制；(3)非毕业年级均可申请，大一大二大三都有机会，大学期间共6次机会；(4)支持填报两个专业志愿。该办法适用于2026级及以后入学的全日制本科生。",
        "attachments": [],
        "publish_date": "2026-03-09",
        "source_department": "教务处"
      },
      {
        "title": "天津大学转专业工作（北洋维基整理）",
        "url": "https://wiki.tjubot.cn/major-changing/general",
        "summary": "全日制本科新生入学后有5次调整专业机会：大一下学期和大二下学期可申请转专业；入学后可经选拔进入未来技术学院；可跨学院进入拔尖班学习；大类分流时多次确认主修专业。转专业遵循“转出无门槛，转入有要求”原则。接收学院制定实施细则，组织笔试/面试等考核。",
        "attachments": [],
        "publish_date": "",
        "source_department": ""
      }
    ],
